# Sentinel-Core Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# Pinecone Configuration (Required)
# ===========================================
# Your Pinecone API key - get it from https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here

# Your Pinecone environment URL (e.g., us-west-2, aws-us-east-1, etc.)
PINECONE_ENV=your_pinecone_environment_here

# ===========================================
# OpenAI Configuration (Required for embeddings)
# ===========================================
# Your OpenAI API key - get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Embedding model to use (default: text-embedding-3-small)
# Other options: text-embedding-3-large, text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# Alternative: Google AI Configuration (Optional)
# ===========================================
# If using Google embeddings instead of OpenAI, set this:
# GOOGLE_API_KEY=your_google_api_key_here
# And change EMBEDDING_MODEL to a Google model (e.g., embedding-001)

# ===========================================
# Optional: Application Configuration
# ===========================================
# Tetragon gRPC address for event ingestion
# TETRAGON_GRPC_ADDRESS=localhost:50001

# API port for the forwarder service
# API_PORT=8081
